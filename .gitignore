# Ignore default plugins (keep only custom)
/wp-content/plugins/akismet/
/wp-content/plugins/hello.php
/wp-content/plugins/index.php

# Ignore sensitive config
wp-config.php

# Ignore OS/editor junk
.DS_Store
Thumbs.db