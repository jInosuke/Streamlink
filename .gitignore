# Ignore WordPress core
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/xmlrpc.php
/readme.html
/license.txt

# Ignore uploads and generated content
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/

# Ignore default themes (keep only yours)
/wp-content/themes/twentytwenty*/
